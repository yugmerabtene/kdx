{
  "version": "2026-03-24.qcm.1",
  "status": "authoritative_user_answers",
  "notes": [
    "This file is generated from interactive QCM answers and used as spec-tracking source of truth.",
    "Some features are intentionally marked target/future until implementation catches up.",
    "Global function style normalized from user sample typo `cacl` to `calc` in examples."
  ],
  "syntax": {
    "functions": {
      "global_style": "function <return_type> <name>(<typed_params>) { ... }",
      "typed_params": "<type> <name>",
      "allow_global_functions": true,
      "allow_class_methods": true
    },
    "entrypoint": {
      "mode": "dual",
      "preferred_forms": [
        "class Main { void main() { ... } }",
        "function int main() { ... }"
      ]
    },
    "classes": {
      "keyword": "class",
      "main_form": "class Main { ... }",
      "file_rule": "one_class_per_file",
      "modifiers": [
        "public",
        "private",
        "protected"
      ],
      "instantiation": "not_in_mvp_runtime_yet"
    },
    "types": {
      "canonical": [
        "int",
        "float",
        "string",
        "boolean",
        "char",
        "void"
      ],
      "aliases": "disabled",
      "arrays": "<type>[] <name>;",
      "null_literal": "null",
      "char_literal": "'a'"
    },
    "statements": {
      "variables": "<type> <name> = <expr>;",
      "const": "const <type> <name> = <expr>;",
      "return": [
        "return <expr>;",
        "return;"
      ],
      "semicolon": "required",
      "for": "for (<init>; <cond>; <step>) { ... }",
      "switch": "enabled"
    },
    "operators": {
      "arithmetic": [
        "+",
        "-",
        "*",
        "/",
        "%"
      ],
      "assignment": [
        "=",
        "+=",
        "-=",
        "*=",
        "/=",
        "%=",
        "&=",
        "|=",
        "^=",
        "<<=",
        ">>="
      ],
      "comparison": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "===",
        "!=="
      ],
      "logical": [
        "&&",
        "||",
        "!"
      ],
      "increment": [
        "i++",
        "i--"
      ],
      "precedence": "c_like"
    },
    "io": {
      "print_functions": [
        "print(expr)",
        "println(expr)"
      ],
      "string_concat": "plus_operator"
    },
    "casting": {
      "style": "type(expr)",
      "implicit_numeric_conversions": false,
      "boolean_conditions": "strict_boolean_only"
    },
    "modules": {
      "import": "import module;",
      "namespace_model": "class_name_only"
    },
    "advanced": {
      "struct": "complete",
      "enum": "advanced",
      "exceptions": "minimal_try_catch"
    }
  },
  "implementation_targets": {
    "current_focus": [
      "parser_alignment_to_function_return_type_prefix",
      "class_main_entrypoint_support",
      "typed_param_order_type_name",
      "strict_ops_===_!=="
    ],
    "tracking_lane": "quick_tests"
  }
}
