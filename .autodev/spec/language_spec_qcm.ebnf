(* KodPix QCM Spec Grammar Draft - 2026-03-24 *)

program             = { top_level } ;

top_level           = import_decl | global_function | class_decl ;

import_decl         = "import" identifier ";" ;

global_function     = "function" type identifier "(" [ parameter_list ] ")" block ;

class_decl          = "class" identifier "{" { class_member } "}" ;

class_member        = [ visibility ] method_decl ;

visibility          = "public" | "private" | "protected" ;

method_decl         = type identifier "(" [ parameter_list ] ")" block ;

parameter_list      = parameter { "," parameter } ;
parameter           = type identifier ;

type                = "int"
                    | "float"
                    | "string"
                    | "boolean"
                    | "char"
                    | "void"
                    | identifier
                    | type "[]" ;

block               = "{" { statement } "}" ;

statement           = var_decl
                    | const_decl
                    | if_stmt
                    | while_stmt
                    | for_stmt
                    | switch_stmt
                    | try_stmt
                    | return_stmt
                    | expr_stmt
                    | block ;

var_decl            = type identifier [ "=" expression ] ";" ;
const_decl          = "const" type identifier "=" expression ";" ;

if_stmt             = "if" "(" expression ")" statement [ "else" statement ] ;
while_stmt          = "while" "(" expression ")" statement ;
for_stmt            = "for" "(" [ for_init ] ";" [ expression ] ";" [ expression ] ")" statement ;
for_init            = var_decl_for | expression ;
var_decl_for        = type identifier [ "=" expression ] ;

switch_stmt         = "switch" "(" expression ")" "{" { switch_case } [ default_case ] "}" ;
switch_case         = "case" expression ":" { statement } ;
default_case        = "default" ":" { statement } ;

try_stmt            = "try" block "catch" "(" type identifier ")" block ;

return_stmt         = "return" [ expression ] ";" ;
expr_stmt           = expression ";" ;

expression          = assignment ;
assignment          = logical_or [ assign_op assignment ] ;
assign_op           = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

logical_or          = logical_and { "||" logical_and } ;
logical_and         = equality { "&&" equality } ;
equality            = comparison { ("==" | "!=" | "===" | "!==") comparison } ;
comparison          = term { ("<" | "<=" | ">" | ">=") term } ;
term                = factor { ("+" | "-") factor } ;
factor              = unary { ("*" | "/" | "%") unary } ;

unary               = ("!" | "-") unary
                    | cast
                    | postfix ;

cast                = type "(" expression ")" ;

postfix             = primary { call_suffix | inc_suffix } ;
call_suffix         = "(" [ argument_list ] ")" ;
inc_suffix          = "++" | "--" ;
argument_list       = expression { "," expression } ;

primary             = literal
                    | identifier
                    | "(" expression ")" ;

literal             = int_lit | float_lit | string_lit | char_lit | bool_lit | null_lit ;

bool_lit            = "true" | "false" ;
null_lit            = "null" ;

(* Lexer-level rules are intentionally omitted in this draft. *)
