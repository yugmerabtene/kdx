[Unit]
Description=KodPix AutoDev Worker (%i)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
Environment=AUTODEV_WORKER_SLEEP_SECONDS=10
ExecStart=/bin/bash __REPO_ROOT__/.autodev/worker_runner.sh %i
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=default.target
