[Unit]
Description=KodPix Autonomous Multi-Agent Dev Loop
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
ExecStart=/usr/bin/env python3 __REPO_ROOT__/.autodev/run.py --daemon
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=default.target
